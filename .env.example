POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_dev_password
POSTGRES_DB=dhaka_tesla_pool
DATABASE_URL=postgresql://tesla:tesla_dev_password@db:5432/dhaka_tesla_pool

API_PORT=3001
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend (local dev: npm run dev in frontend/)
# VITE_API_URL is optional — Vite proxies /api to localhost:3001 by default.
VITE_API_URL=http://localhost:3001
